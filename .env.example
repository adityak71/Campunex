# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campunex
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campunex

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-campunex-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d

# Spatial Matching Threshold (in meters)
MATCHING_PROXIMITY_METERS=500

# OTP Settings
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Dev Simulation
ENABLE_DEV_SIMULATOR=true
