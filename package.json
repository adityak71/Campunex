{
  "name": "campunex-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently -n \"SERVER,WEB\" -c \"green,blue\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:all": "npm run dev",
    "clean": "npm run clean --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server": "npm run build --workspace=packages/shared && npm run build --workspace=apps/server",
    "build:web": "npm run build --workspace=packages/shared && npm run build --workspace=apps/web",
    "start:server": "npm run start --workspace=apps/server",
    "start:web": "npm run start --workspace=apps/web",
    "build": "npm run build:shared && npm run build:server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
